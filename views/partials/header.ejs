<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>F&F | Main Page</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header class="page-header">
    <a href="/" class="page-header__branding">
      <img src="/images/logo.png" class="page-header__logo-img">
      <h1 class="page-header__logo-text">F&F</h1>
    </a>

    <nav class="page-header__nav">
      <a href="/messages/new" class="page-header__message-link">Send new message</a>
    </nav>

    <div class="page-header__actions">
    <% if (currentUser) {%>
      <% if (!currentUser.is_member) { %>
      <a href="/join" class="btn btn--join">Join</a>
      <% } %>
      <a href="/log-out" class="btn btn--logout">Log Out</a>

     <%} else {%> 
    
      <a href="/log-in" class="btn btn--login">Log In</a>
      <a href="/sign-up" class="btn btn--signup ">Sign Up</a>
      <% } %>
    </div>
  </header>